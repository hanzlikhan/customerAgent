# DukaanAI environment config
# 1. Get a FREE Groq API key at https://console.groq.com (sign up -> API Keys -> Create)
# 2. Copy this file to .env  (Windows: copy .env.example .env)
# 3. Paste your key below. Never commit .env to git.

GROQ_API_KEY=your_key_here

# Optional overrides (defaults are fine for Phase 0+)
# GROQ_MODEL=openai/gpt-oss-120b
# SIMILARITY_THRESHOLD=0.40
